# Example environment variables for bio-stock-api
# Copy to .env and edit values before running locally or in Docker.
APP_ENV=development
JWT_SECRET_KEY=dev-secret-change-me
JWT_PREVIOUS_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
DATABASE_URL=sqlite:///./biostock.db

# Optional: database credentials for a production DB (example)
# DATABASE_URL=postgresql://user:pass@localhost:5432/biostock
